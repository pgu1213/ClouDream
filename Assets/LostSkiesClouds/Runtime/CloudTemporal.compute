#pragma kernel Reproject
#pragma multi_compile _ CLOUD_COMPACT_TARGETS
#pragma only_renderers dx12

// 색 alpha와 최초 깊이의 기존 계약은 유지하고 실제 적분 깊이 분산은 별도 RGFloat로 저장합니다.
Texture2DArray<float4> _PreviousLighting;
Texture2DArray<float4> _PreviousTransmission;
Texture2DArray<float2> _PreviousState;
Texture2DArray<float2> _PreviousDepthMoments;
Texture2DArray<float4> _CurrentDepth;
RWTexture2DArray<float4> _CurrentLighting;
#ifdef CLOUD_COMPACT_TARGETS
RWTexture2DArray<float2> _CurrentTransmission;
#else
RWTexture2DArray<float4> _CurrentTransmission;
#endif
RWTexture2DArray<float2> _CurrentState;
RWTexture2DArray<float2> _CurrentDepthMoments;

AppendStructuredBuffer<uint2> _TemporalRetraceTiles;
RWStructuredBuffer<uint> _TemporalDiagnostics;

float4 _TemporalSize, _TemporalZ;
float4 _TemporalPosition, _TemporalForward, _TemporalRight, _TemporalUp;
float4 _PreviousPosition, _PreviousForward, _PreviousRight, _PreviousUp;
float4 _TemporalLightingAgeChange;
float4 _TemporalDeformationAgeChange;
float _TemporalLightingLimit;
float _TemporalDeformationLimit;
int _TemporalValid, _TemporalCompact, _TemporalMotion, _TemporalTranslation;
int _TemporalPhases, _TemporalPhase, _TemporalLightingAgeLimit;
int _TemporalDeformationAgeLimit;
int _TemporalCompactTiles, _TemporalDiagnosticsEnabled;

// C# CloudTemporalRejection과 정확히 같은 순서입니다. 그룹 합계만 전역 원자 연산으로 기록합니다.
#define TEMPORAL_REUSED 0
#define TEMPORAL_SCHEDULED 1
#define TEMPORAL_SHAPE_INVALID 2
#define TEMPORAL_LIGHTING_CHANGED 3
#define TEMPORAL_OFFSCREEN 4
#define TEMPORAL_DEPTH_MISMATCH 5
#define TEMPORAL_FOREGROUND 6
#define TEMPORAL_BOUNDARY 7
#define TEMPORAL_AGE 8
#define TEMPORAL_VARIANCE 9
#define TEMPORAL_INVALID 10
#define TEMPORAL_EMPTY_TRANSLATION 11
#define TEMPORAL_DEFORMATION_CHANGED 12
#define TEMPORAL_REASON_COUNT 13

groupshared uint temporalGroupReasons[TEMPORAL_REASON_COUNT];
groupshared uint temporalGroupNeedsTrace;

// 렌더러와 같은 좌상단 UV 및 perspective 광선 계약을 사용합니다.
float3 TemporalRay(float2 uv, float3 forward, float3 right, float3 up)
{
    return normalize(forward + (uv.x * 2 - 1) * right + (1 - uv.y * 2) * up);
}

// 임의의 월드 점을 카메라의 비지터 perspective UV에 투영합니다.
bool TemporalProject(float3 position, float3 camera, float3 forward, float3 right, float3 up, out float2 uv)
{
    float3 delta = position - camera;
    float depth = dot(delta, forward);
    uv = 0;
    if (depth <= 0.001)
    {
        return false;
    }

    uv.x = 0.5 + 0.5 * dot(delta, right) / (depth * dot(right, right));
    uv.y = 0.5 - 0.5 * dot(delta, up) / (depth * dot(up, up));
    return all(uv >= 0) && all(uv < 1);
}

// 모서리 밖의 오래된 값을 clamp로 끌어오지 않으며 호출 전 UV 범위를 검사합니다.
int2 TemporalPixel(float2 uv)
{
    return min((int2)(uv * _TemporalSize.xy), (int2)_TemporalSize.xy - 1);
}

// Compact/Regular의 첫 교차 거리 채널을 일관되게 읽습니다.
float TemporalFirstHit(float4 transmission)
{
    if (_TemporalCompact != 0)
    {
        return transmission.g;
    }

    return transmission.a;
}

// 가장자리·서로 다른 구름 깊이가 섞인 곳은 재투영 오차보다 새 광선 계산을 우선합니다.
bool TemporalSmoothNeighborhood(int2 pixel, float transmission, float distance)
{
    [unroll]
    for (int axis = 0; axis < 4; axis++)
    {
        int2 offset = int2(-1, 0);
        if (axis == 1)
        {
            offset = int2(1, 0);
        }

        if (axis == 2)
        {
            offset = int2(0, -1);
        }

        if (axis == 3)
        {
            offset = int2(0, 1);
        }

        int2 neighbor = clamp(pixel + offset, int2(0, 0), (int2)_TemporalSize.xy - 1);
        float t = _PreviousTransmission.Load(int4(neighbor, 0, 0)).r;
        float d = _PreviousDepthMoments.Load(int4(neighbor, 0, 0)).x;
        if (abs(t - transmission) > 0.04 || abs(d - distance) > max(8, distance * 0.02))
        {
            return false;
        }
    }

    return true;
}

// 깊이 모멘트는 opacity 가중 혼합하고 나이는 가장 오래된 값을 보존하여 조명 변화 검사를 보수적으로 합니다.
uint TemporalBilinear(float2 uv, bool requireEmpty, out float4 light, out float4 transmission, out float2 state, out float2 moments)
{
    float2 location = uv * _TemporalSize.xy - 0.5;
    int2 basePixel = (int2)floor(location);
    float2 fraction = frac(location);
    light = 0;
    transmission = 0;
    state = 0;
    moments = 0;
    if (any(basePixel < 0) || any(basePixel + 1 >= (int2)_TemporalSize.xy))
    {
        return TEMPORAL_OFFSCREEN;
    }

    float minimumT = 1;
    float maximumT = 0;
    float minimumDepth = 1e20;
    float maximumDepth = 0;
    float minimumScene = 1;
    float maximumScene = 0;
    float opacityWeight = 0;
    [unroll]
    for (int y = 0; y < 2; y++)
    {
        [unroll]
        for (int x = 0; x < 2; x++)
        {
            int4 pixel = int4(basePixel + int2(x, y), 0, 0);
            float4 l = _PreviousLighting.Load(pixel);
            float4 t = _PreviousTransmission.Load(pixel);
            if (requireEmpty && t.r < 0.9999)
            {
                return TEMPORAL_BOUNDARY;
            }

            float2 s = _PreviousState.Load(pixel);
            float2 m = _PreviousDepthMoments.Load(pixel);
            float2 weights = lerp(1 - fraction, fraction, float2(x, y));
            float weight = weights.x * weights.y;
            light += l * weight;
            transmission += t * weight;
            state.x += s.x * weight;
            state.y = max(state.y, s.y);
            float weightedOpacity = weight * max(0, 1 - t.r);
            opacityWeight += weightedOpacity;
            moments.x += m.x * weightedOpacity;
            moments.y += (m.y + m.x * m.x) * weightedOpacity;
            minimumT = min(minimumT, t.r);
            maximumT = max(maximumT, t.r);
            minimumDepth = min(minimumDepth, m.x);
            maximumDepth = max(maximumDepth, m.x);
            minimumScene = min(minimumScene, s.x);
            maximumScene = max(maximumScene, s.x);
        }
    }

    if (opacityWeight > 0.0001)
    {
        moments /= opacityWeight;
        moments.y = max(0, moments.y - moments.x * moments.x);
    }
    else
    {
        moments = 0;
    }

    if (maximumT - minimumT > 0.02)
    {
        return TEMPORAL_BOUNDARY;
    }

    if (maximumDepth - minimumDepth > max(4, minimumDepth * 0.01))
    {
        return TEMPORAL_DEPTH_MISMATCH;
    }

    if (maximumScene - minimumScene > max(1e-8, minimumScene * 0.005))
    {
        return TEMPORAL_FOREGROUND;
    }

    return TEMPORAL_REUSED;
}

// 한 대표점이 서로 다른 볼륨 깊이를 대신할 수 없는 경우에는 분산의 화면상 폭으로 재사용을 거절합니다.
bool TemporalDepthFootprint(float3 oldRay, float2 moments)
{
    float spread = sqrt(max(0, moments.y));
    float3 nearPoint = _PreviousPosition.xyz + oldRay * max(0.01, moments.x - spread);
    float3 farPoint = _PreviousPosition.xyz + oldRay * (moments.x + spread);
    float2 nearUV;
    float2 farUV;
    if (!TemporalProject(nearPoint, _TemporalPosition.xyz, _TemporalForward.xyz,
        _TemporalRight.xyz, _TemporalUp.xyz, nearUV))
    {
        return false;
    }

    if (!TemporalProject(farPoint, _TemporalPosition.xyz, _TemporalForward.xyz,
        _TemporalRight.xyz, _TemporalUp.xyz, farUV))
    {
        return false;
    }

    return length((farUV - nearUV) * _TemporalSize.xy) <= 0.75;
}

// G=0으로 남은 픽셀은 같은 프레임에 다시 적분하며 실패 사유는 서로 겹치지 않는 하나의 값입니다.
uint TemporalReprojectPixel(uint3 id)
{
    float sceneDepth = _CurrentDepth.Load(int4(id.xy, 0, 0)).r;
    _CurrentState[id] = float2(sceneDepth, 0);
    _CurrentDepthMoments[id] = 0;
    if (_TemporalValid == 0)
    {
        return TEMPORAL_SHAPE_INVALID;
    }

    uint2 tile = id.xy / 8;
    int selected = (tile.x + tile.y) % 2;
    if (_TemporalPhases == 4)
    {
        selected = (tile.x % 2) + 2 * (tile.y % 2);
    }

    if (selected == _TemporalPhase)
    {
        return TEMPORAL_SCHEDULED;
    }

    if (_TemporalLightingAgeChange.x > _TemporalLightingLimit)
    {
        return TEMPORAL_LIGHTING_CHANGED;
    }

    float2 uv = (id.xy + 0.5) * _TemporalSize.zw;
    float3 ray = TemporalRay(uv, _TemporalForward.xyz, _TemporalRight.xyz, _TemporalUp.xyz);
    float2 historyUV = uv;
    float4 light = _PreviousLighting.Load(int4(id.xy, 0, 0));
    float4 transmission = _PreviousTransmission.Load(int4(id.xy, 0, 0));
    float2 moments = _PreviousDepthMoments.Load(int4(id.xy, 0, 0));
    float distance = moments.x;
    bool empty = transmission.r >= 0.9999;
    if (_TemporalMotion != 0)
    {
        if (empty)
        {
            if (_TemporalTranslation != 0)
            {
                return TEMPORAL_EMPTY_TRANSLATION;
            }

            // 같은 원점에서의 회전만 있을 때 빈 광선은 방향만 재투영해도 같은 공간을 통과합니다.
            distance = 42000;
        }
        else if (distance <= 0)
        {
            return TEMPORAL_INVALID;
        }

        // 실제 적분 평균 깊이로 현재 광선을 투영하고, 깊이 차이가 있는 경우 두 번 보정합니다.
        [unroll]
        for (int iteration = 0; iteration < 3; iteration++)
        {
            float3 estimate = _TemporalPosition.xyz + ray * distance;
            if (!TemporalProject(estimate, _PreviousPosition.xyz, _PreviousForward.xyz,
                _PreviousRight.xyz, _PreviousUp.xyz, historyUV))
            {
                return TEMPORAL_OFFSCREEN;
            }

            int2 source = TemporalPixel(historyUV);
            light = _PreviousLighting.Load(int4(source, 0, 0));
            transmission = _PreviousTransmission.Load(int4(source, 0, 0));
            moments = _PreviousDepthMoments.Load(int4(source, 0, 0));
            if (empty != (transmission.r >= 0.9999))
            {
                return TEMPORAL_BOUNDARY;
            }

            if (!empty)
            {
                float2 sourceUV = (source + 0.5) * _TemporalSize.zw;
                float3 previousRay = TemporalRay(sourceUV, _PreviousForward.xyz, _PreviousRight.xyz, _PreviousUp.xyz);
                float3 world = _PreviousPosition.xyz + previousRay * moments.x;
                distance = dot(world - _TemporalPosition.xyz, ray);
            }
        }
    }

    int2 historyPixel = TemporalPixel(historyUV);
    float2 state = _PreviousState.Load(int4(historyPixel, 0, 0));
    if (_TemporalMotion != 0)
    {
        uint reconstruction = TemporalBilinear(historyUV, empty, light, transmission, state, moments);
        if (reconstruction != TEMPORAL_REUSED)
        {
            return reconstruction;
        }
    }

    float age = state.y + 1;
    if (age >= _TemporalPhases)
    {
        return TEMPORAL_AGE;
    }

    if (age < 1 || !all(isfinite(light)) || !all(isfinite(transmission)) || !all(isfinite(moments))
        || moments.y < 0 || !all(isfinite(state)))
    {
        return TEMPORAL_INVALID;
    }

    int lightingAge = clamp((int)age - 1, 0, 3);
    if (age > _TemporalLightingAgeLimit || _TemporalLightingAgeChange[lightingAge] > _TemporalLightingLimit)
    {
        return TEMPORAL_LIGHTING_CHANGED;
    }

    // 노이즈 입력 변화만 제한합니다. 바람을 구름 몸체의 강체 이동 벡터로 적용하지 않습니다.
    if (age > _TemporalDeformationAgeLimit || _TemporalDeformationAgeChange[lightingAge] > _TemporalDeformationLimit)
    {
        return TEMPORAL_DEFORMATION_CHANGED;
    }

    if ((sceneDepth == 0) != (state.x == 0))
    {
        return TEMPORAL_FOREGROUND;
    }

    float2 sampledUV = (historyPixel + 0.5) * _TemporalSize.zw;
    if (_TemporalMotion != 0)
    {
        sampledUV = historyUV;
    }

    float3 oldRay = TemporalRay(sampledUV, _PreviousForward.xyz, _PreviousRight.xyz, _PreviousUp.xyz);
    float firstHit = TemporalFirstHit(transmission);
    if (_TemporalMotion != 0 && !empty)
    {
        float oldDistance = moments.x;
        float3 world = _PreviousPosition.xyz + oldRay * oldDistance;
        float2 checkUV;
        if (!TemporalProject(world, _TemporalPosition.xyz, _TemporalForward.xyz,
            _TemporalRight.xyz, _TemporalUp.xyz, checkUV))
        {
            return TEMPORAL_OFFSCREEN;
        }

        if (length((checkUV - uv) * _TemporalSize.xy) > 0.75)
        {
            return TEMPORAL_DEPTH_MISMATCH;
        }

        if (!TemporalSmoothNeighborhood(historyPixel, transmission.r, oldDistance))
        {
            return TEMPORAL_BOUNDARY;
        }

        if (!TemporalDepthFootprint(oldRay, moments))
        {
            return TEMPORAL_VARIANCE;
        }

        // 새 광선에 대한 affine 거리 변환은 평균과 분산을 함께 바꾸며 바람의 강체 이동은 가정하지 않습니다.
        distance = max(0, dot(world - _TemporalPosition.xyz, ray));
        float projectionScale = dot(oldRay, ray);
        moments = float2(distance, moments.y * projectionScale * projectionScale);
        light.a = distance * (1 - transmission.r);
        float3 firstWorld = _PreviousPosition.xyz + oldRay * firstHit;
        firstHit = max(0, dot(firstWorld - _TemporalPosition.xyz, ray));
    }

    if (sceneDepth > 0)
    {
        float currentEye = rcp(sceneDepth * _TemporalZ.x + _TemporalZ.y);
        float oldEye = rcp(state.x * _TemporalZ.x + _TemporalZ.y);
        float3 oldSurface = _PreviousPosition.xyz + oldRay * oldEye / max(0.001, dot(oldRay, _PreviousForward.xyz));
        float predictedEye = dot(oldSurface - _TemporalPosition.xyz, _TemporalForward.xyz);
        if (abs(currentEye - predictedEye) > max(0.5, currentEye * 0.005)
            || (transmission.r < 0.9999 && distance * dot(ray, _TemporalForward.xyz) > currentEye + 0.5))
        {
            return TEMPORAL_FOREGROUND;
        }
    }

    _CurrentLighting[id] = light;
    #ifdef CLOUD_COMPACT_TARGETS
    _CurrentTransmission[id] = float2(transmission.r, firstHit);
    #else
    _CurrentTransmission[id] = float4(transmission.rrr, firstHit);
    #endif
    _CurrentDepthMoments[id] = moments;
    _CurrentState[id] = float2(sceneDepth, age);
    return TEMPORAL_REUSED;
}

// 모든 그룹 스레드가 barrier에 도달하게 하여 재추적 목록에는 필요한 타일 하나만 추가합니다.
[numthreads(8, 8, 1)]
void Reproject(uint3 id : SV_DispatchThreadID, uint3 group : SV_GroupID, uint index : SV_GroupIndex)
{
    if (index == 0)
    {
        temporalGroupNeedsTrace = 0;
    }

    if (index < TEMPORAL_REASON_COUNT)
    {
        temporalGroupReasons[index] = 0;
    }

    GroupMemoryBarrierWithGroupSync();
    if (all(id.xy < (uint2)_TemporalSize.xy))
    {
        uint reason = TemporalReprojectPixel(id);
        if (_TemporalDiagnosticsEnabled != 0)
        {
            InterlockedAdd(temporalGroupReasons[reason], 1);
        }

        if (_TemporalCompactTiles != 0 && reason != TEMPORAL_REUSED)
        {
            InterlockedOr(temporalGroupNeedsTrace, 1);
        }
    }

    GroupMemoryBarrierWithGroupSync();
    if (_TemporalCompactTiles != 0 && index == 0 && temporalGroupNeedsTrace != 0)
    {
        _TemporalRetraceTiles.Append(group.xy);
    }

    if (_TemporalDiagnosticsEnabled != 0 && index < TEMPORAL_REASON_COUNT)
    {
        uint count = temporalGroupReasons[index];
        if (count > 0)
        {
            InterlockedAdd(_TemporalDiagnostics[index], count);
        }
    }
}
